{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListMoviraHelpCenterBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::movira-help-center-072508717210-prod"
    },
    {
      "Sid": "DeployMoviraHelpCenter",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::movira-help-center-072508717210-prod/*"
    },
    {
      "Sid": "InvalidateMoviraHelpCenterCloudFront",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::072508717210:distribution/E48XR9YKCMSTD"
    }
  ]
}
